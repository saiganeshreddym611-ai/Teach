# Required for live grading / tutoring. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Set to 1 to run the whole loop with a deterministic fake LLM (no key, no cost).
MOCK_LLM=0

# Claude model for the tutor voice (and the grader when GRADER_PROVIDER=claude).
TUTOR_MODEL=claude-opus-5

# Backends per role: claude | ollama. With ollama, the model must be pulled (`ollama pull <model>`)
# and the Ollama server running; :cloud models need `ollama signin`.
GRADER_PROVIDER=claude
TUTOR_PROVIDER=claude
OLLAMA_MODEL=nemotron-3-super:cloud
OLLAMA_HOST=http://localhost:11434

# Comma-separated origins allowed to call the API (the Next.js dev server by default).
CORS_ORIGINS=http://localhost:3000
